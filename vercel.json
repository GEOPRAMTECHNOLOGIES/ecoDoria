{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/escalate",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/hotspots",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/kyc-retention",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/weekly-summary",
      "schedule": "0 8 * * 1"
    }
  ]
}